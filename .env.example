# =============================================================================
# ClipForge AI — Environment Variables
# Copy this file to .env and fill in values
# =============================================================================

# --- App ---
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="ClipForge AI"

# --- Database (PostgreSQL) ---
# Local example: postgresql://user:password@localhost:5432/clipforge?schema=public
# Netlify + Neon/Supabase example: postgresql://user:pass@host/db?sslmode=require
DATABASE_URL="postgresql://clipforge:clipforge@localhost:5432/clipforge?schema=public"

# --- Auth ---
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-strong-random-32-char-secret"
JWT_EXPIRES_IN="7d"

# --- Storage (S3-compatible) ---
# Supports AWS S3, Cloudflare R2, Supabase Storage, or any S3-compatible provider
# For V1: set to enable signed URL flow. If empty, upload falls back to local mock.
STORAGE_PROVIDER="s3" # s3 | r2 | supabase | local
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="clipforge-uploads"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_ENDPOINT="" # e.g. https://<account>.r2.cloudflarestorage.com for R2, leave empty for AWS
STORAGE_PUBLIC_BASE_URL="" # e.g. https://cdn.clipforge.ai or https://bucket.s3.amazonaws.com

# Max upload size in bytes (default 2GB = 2147483648)
MAX_UPLOAD_BYTES="2147483648"

# --- Firebase (Client SDK) ---
# Public values (apiKey is safe to expose client-side). For Netlify, set NEXT_PUBLIC_ vars in dashboard.
NEXT_PUBLIC_FIREBASE_API_KEY="AIzaSyD6gnGoSEraOVbss9QMOaaZT502rtpDETU"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="clipforge-ai-910f9.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_DATABASE_URL="https://clipforge-ai-910f9-default-rtdb.asia-southeast1.firebasedatabase.app"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="clipforge-ai-910f9"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="clipforge-ai-910f9.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="892050276818"
NEXT_PUBLIC_FIREBASE_APP_ID="1:892050276818:web:c827cf86dee53bd378880b"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="G-RV1Z109SRH"

# --- Optional: Backend (FastAPI) ---
# If you deploy Python worker separately
PYTHON_API_URL=http://localhost:8000
PYTHON_API_KEY=""

# --- ClipForge AI API (Project fpq) — server-side only ---
# Never expose to client. Set in Netlify dashboard (Build env vars) and .env.local locally.
# Retrieve from ClipForge portal — project/upload name is fpq.
CLIPFORGE_API_KEY="cDMD8gx5Ht63kiXrfFGeAPG7vr8"
CLIPFORGE_BASE_URL="https://api.clipforge.ai" # Override with real ClipForge endpoint if different; code appends /v1/jobs
CLIPFORGE_WEBHOOK_SECRET="" # Optional — if ClipForge sends webhooks, paste signing secret here for HMAC verification
CLIPFORGE_PROJECT_ID="fpq"

# --- Firebase Admin (server-side) — for ID token verification & Firestore/Storage via Admin SDK ---
# Option A (preferred): base64-encoded service-account JSON → set FIREBASE_ADMIN_CREDENTIALS
#   cat serviceAccount.json | base64 -w0
# Option B: raw JSON string in FIREBASE_SERVICE_ACCOUNT
# If neither is set, server falls back to in-memory mock (dev only) — set in production.
# FIREBASE_ADMIN_CREDENTIALS=""
# FIREBASE_SERVICE_ACCOUNT=""

# Optional: overridable ClipForge API base used by server: CLIPFORGE_API_BASE_URL
# V3 highlights: auto-detect gaming highlights via ClipForge AI (project fpq) → Firestore highlights + Firebase Storage clips
# See HIGHLIGHTS_V3.md for pipeline. No per-video manual start; worker handles long-running outside Netlify Functions.
WORKER_SECRET="" # Optional — if set, POST /api/worker/highlights/tick requires x-worker-secret: <WORKER_SECRET> (defaults to CLIPFORGE_API_KEY)
WORKER_FRONTEND_URL="" # Optional — Python worker -> Next.js tick URL, defaults to NEXT_PUBLIC_APP_URL (e.g. https://clipforge99.netlify.app)

# --- Cloudinary (Video Storage) — server-side secret stays on server ---
# Get from https://console.cloudinary.com -> Settings -> API Keys
# For direct signed uploads: client POSTs to https://api.cloudinary.com/v1_1/<cloud_name>/video/upload
# Server generates signature with API_SECRET (never sent to browser).
# SECURITY: CLOUDINARY_URL contains api_secret — keep server-side only, never NEXT_PUBLIC_, never commit real value, never log
# Preferred: set CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name> (server-only)
CLOUDINARY_URL="cloudinary://<api-key>:<api-secret>@<cloud-name>"
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret-keep-server-only"
# Public cloud name for client previews/thumbnails (safe to expose, no secret)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
# Optional: set CLOUDINARY_MOCK=true to test without real Cloudinary account (uses mock URLs)
# CLOUDINARY_MOCK="false"

# --- Optional: Observability ---
# LOG_LEVEL=info


# Testing — keep mock separate
TEST_MODE="false"
CLOUDINARY_MOCK="false"
MOCK_CLIPFORGE_FAILURE="false"
