rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cloudinary videos — per-user isolation (V2 primary) — actual video bytes in Cloudinary
    // Path: users/{uid}/videos/{videoId} with fields fileName, cloudinaryPublicId, cloudinaryUrl, ownerId etc.
    // Do NOT store actual video files in Firestore — only metadata
    match /users/{uid}/videos/{videoId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Ensure ownerId matches and publicId prefix is users/{uid}/videos/
      allow create: if request.auth.uid == uid
                    && request.resource.data.ownerId == uid
                    && request.resource.data.cloudinaryPublicId.matches('users/' + uid + '/videos/.*');
    }

    // ClipForge jobs — per-user isolation
    // Path: users/{uid}/jobs/{jobId}
    match /users/{uid}/jobs/{jobId} {
      // Only the owning user (uid == auth.uid) can read/write
      // ClipForge fields: provider == "clipforge", project == "fpq"
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Optional: enforce project fpq on create
      allow create: if request.auth.uid == uid
                    && request.resource.data.provider == "clipforge"
                    && request.resource.data.project == "fpq";
    }

    // (Optional) extend for other per-user data
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
