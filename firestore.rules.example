rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ClipForge jobs — per-user isolation
    // Path: users/{uid}/jobs/{jobId}
    match /users/{uid}/jobs/{jobId} {
      // Only the owning user (uid == auth.uid) can read/write
      // ClipForge fields: provider == "clipforge", project == "fpq"
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Optional: enforce project fpq on create
      allow create: if request.auth.uid == uid
                    && request.resource.data.provider == "clipforge"
                    && request.resource.data.project == "fpq";
    }

    // (Optional) extend for other per-user data
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
